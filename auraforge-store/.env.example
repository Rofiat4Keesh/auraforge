# =====================================================================
#  AURAFORGE WIDE TECHNOLOGIES LTD — Environment configuration
#  Copy this file to ".env" and fill in your real values:
#      cp .env.example .env        (macOS / Linux / Git Bash)
#      copy .env.example .env      (Windows Command Prompt)
#  NEVER commit the real .env file to Git.
# =====================================================================

# ---------------------------------------------------------------------
# 1. DATABASE (MongoDB)
# ---------------------------------------------------------------------
# Option A — MongoDB Atlas (free cloud database, easiest):
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/auraforge?retryWrites=true&w=majority
# Option B — Local Docker (run `docker compose up -d` first):
#   mongodb://localhost:27017/auraforge?replicaSet=rs0&directConnection=true
DATABASE_URL="mongodb://localhost:27017/auraforge?replicaSet=rs0&directConnection=true"

# ---------------------------------------------------------------------
# 2. PAYSTACK (https://dashboard.paystack.com/#/settings/developers)
# ---------------------------------------------------------------------
# Use pk_test_/sk_test_ keys while developing; switch to pk_live_/sk_live_ when you go live.
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_BASE_URL="https://api.paystack.co"

# ---------------------------------------------------------------------
# 3. DOMAIN / URL PARAMETERS
# ---------------------------------------------------------------------
# Full public URL of the site (no trailing slash). Used for Paystack callback,
# SEO metadata and absolute links.
#   Local:      http://localhost:3000
#   Production: https://www.auraforge.ng   (example — use your real domain)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Bare custom domain (no protocol). Leave empty for localhost.
APP_DOMAIN=""

# Cookie domain. Leave EMPTY for localhost. In production set e.g. ".auraforge.ng"
# so the login/cart cookies work on both auraforge.ng and www.auraforge.ng.
COOKIE_DOMAIN=""

# ---------------------------------------------------------------------
# 4. SECURITY
# ---------------------------------------------------------------------
# Long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string-of-at-least-32-characters"

# First Admin Portal account, created by:  npm run seed:admin
# Fill these in, run the command once, then delete ADMIN_PASSWORD from this file.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# ---------------------------------------------------------------------
# 5. CURRENCY
# ---------------------------------------------------------------------
# Prices are stored and charged in the BASE currency (NGN by default, in kobo).
# DISPLAY currency can be switched to USD; NGN amounts are converted for display
# using NEXT_PUBLIC_NGN_PER_USD.
NEXT_PUBLIC_BASE_CURRENCY="NGN"
NEXT_PUBLIC_DISPLAY_CURRENCY="NGN"
NEXT_PUBLIC_NGN_PER_USD="1550"

# Shipping (amounts in NAIRA, not kobo)
SHIPPING_FLAT_FEE_NGN="5000"
FREE_SHIPPING_THRESHOLD_NGN="500000"

# ---------------------------------------------------------------------
# 6. RESELLER / SUPPLIER FEED
# ---------------------------------------------------------------------
# "technocrat" = your price list in src/data/products.json (prices already include your markup)
# "http"       = pull from a wholesale supplier API
# "mock"       = the original demo catalog
SUPPLIER_SOURCE="technocrat"
# products.json has no stock counts: in-stock items start with this many units. Adjust in Admin → Products.
SUPPLIER_DEFAULT_STOCK="5"
SUPPLIER_API_URL=""
SUPPLIER_API_KEY=""
# Your retail markup on supplier cost price, in percent (used only for the "http" source).
SUPPLIER_MARKUP_PERCENT="18"

# Product photo cache (npm run images:cache).
# Hosts the script may copy product photos from, comma separated. Keep ONLY hosts whose photos you have
# permission to use (e.g. written permission from Technocrat, or a manufacturer's reseller media licence).
# Leave empty ("") to turn downloading off; photos you save by hand in public/images/products still work.
IMAGE_SOURCE_HOSTS="technocratblessingcomputers.fra1.digitaloceanspaces.com,www.technocratng.com,technocratng.com"

# ---------------------------------------------------------------------
# 7. BUSINESS DETAILS SHOWN IN THE FOOTER  — REPLACE WITH YOUR REAL DETAILS
# ---------------------------------------------------------------------
NEXT_PUBLIC_BUSINESS_ADDRESS="Replace with your CAC-registered office address, City, State, Nigeria"
NEXT_PUBLIC_SUPPORT_EMAIL="support@yourdomain.ng"
NEXT_PUBLIC_SUPPORT_PHONE="+234 000 000 0000"
